rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(["uid","name","email","bio","photoURL","followers","following","createdAt"]);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name","bio","photoURL"]);
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["uid","author","text","imageUrl","mediaUrl","mediaType","likes","comments","createdAt"])
        && request.resource.data.likes == 0
        && request.resource.data.comments == 0
        && request.resource.data.mediaType in ["","image","video"];
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text","imageUrl","mediaUrl","mediaType"]);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;

      match /likes/{userId} {
        allow read: if signedIn();
        allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
        allow delete: if isOwner(userId);
        allow update: if false;
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(["uid","author","text","createdAt"]);
        allow update: if false;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followingUid != request.auth.uid
        && followId == request.auth.uid + "_" + request.resource.data.followingUid;
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.receiverUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.receiverUid != request.auth.uid;
      allow update: if signedIn()
        && resource.data.receiverUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
      allow delete: if false;
    }
  }
}

